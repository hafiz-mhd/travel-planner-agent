# Copy this file to .env and fill in your values

# ── Database ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=travel_planner
DB_USER=root
DB_PASSWORD=your_mysql_password

# ── IBM watsonx ────────────────────────────────────────────────
IBM_API_KEY=<your-ibm-api-key>
IBM_URL=https://us-south.ml.cloud.ibm.com/ml/v1/text/generation?version=2023-05-29
IBM_PROJECT_ID=<your-project-id>
IBM_MODEL_ID=ibm/granite-4-h-small
IBM_IAM_URL=https://iam.cloud.ibm.com/identity/token

# ── OpenWeatherMap (optional) ──────────────────────────────────
OPENWEATHER_API_KEY=

# ── RAG ────────────────────────────────────────────────────────
RAG_DATA_DIR=rag/data/destinations
CHROMA_PERSIST_DIR=rag/embeddings/chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5

# ── LLM Retry ──────────────────────────────────────────────────
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=2.0
